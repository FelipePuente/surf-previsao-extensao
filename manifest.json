{
  "manifest_version": 3,
  "name": "Surf Forecast RJ - Previsão & Marés",
  "version": "1.1",
  "description": "Previsão de ondas, vento, marés e relatório diário para o Rio de Janeiro.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://marine-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ]
}